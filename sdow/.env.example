# Copy to .env.local in this directory. Never put credentials in website/.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Minimum seconds between request starts (one in flight). Increase for your quota.
GEMINI_INTERVAL_SECONDS=6

# Optional local Deep Agents research chat backed by MongoDB Atlas.
# Configure Atlas Network Access and a database user before adding this URI.
MONGODB_URI=
MONGODB_DATABASE=wikiwormhole
GEMINI_AGENT_MODEL=gemini-3.1-flash-lite
