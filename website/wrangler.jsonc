{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsbetween",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {"name": "RATE_LIMITER", "namespace_id": "1002", "simple": {"limit": 120, "period": 60}},
    {"name": "MODEL_RATE_LIMITER", "namespace_id": "1003", "simple": {"limit": 30, "period": 60}}
  ],
  "observability": {"enabled": true},
  "vars": {"GEMINI_MODEL": "gemini-3.1-flash-lite", "MONGODB_DATABASE": "whatsbetween"}
}
