{
  "name": "whatsbetween",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.16.0"
  },
  "dependencies": {
    "@langchain/core": "1.4.0",
    "@langchain/google-genai": "2.3.6",
    "d3": "7.9.2",
    "deepagents": "1.16.4",
    "langchain": "1.6.5",
    "lodash": "4.18.1",
    "mongodb": "7.8.0",
    "react": "19.3.1",
    "react-autosuggest": "10.1.0",
    "react-dom": "19.3.1",
    "react-modal": "3.16.3",
    "react-router-dom": "6.30.3",
    "styled-components": "6.6.0",
    "typeface-crimson-text": "1.1.13",
    "typeface-quicksand": "1.1.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/d3": "7.4.3",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-autosuggest": "10.1.11",
    "@types/react-dom": "19.3.0",
    "@types/react-modal": "3.16.3",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "source-map-explorer": "2.5.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "wrangler": "4.161.0"
  },
  "scripts": {
    "dev": "vite",
    "analyze": "source-map-explorer build/static/js/*",
    "lint": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json,css}' && echo 'Running ESLint...' && eslint src --report-unused-disable-directives --max-warnings 0 && echo 'All files pass linting!'",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css}'",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "node scripts/local-preview.mjs",
    "test:wikipedia": "node --test scripts/test-wikipedia.mjs",
    "update-deps": "npx npm-check-updates -u --reject 'react-router-dom' && npm install"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
