{
  "name": "whatsbetween",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.16.0"
  },
  "dependencies": {
    "@langchain/core": "1.4.0",
    "@langchain/google-genai": "2.3.6",
    "deepagents": "1.16.5",
    "langchain": "1.6.5",
    "langsmith": "0.12.0",
    "mongodb": "7.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "typeface-crimson-text": "1.1.13",
    "typeface-quicksand": "1.1.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "wrangler": "4.161.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json,css}' && echo 'Running ESLint...' && eslint src --report-unused-disable-directives --max-warnings 0 && echo 'All files pass linting!'",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css}'",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "node scripts/local-preview.mjs",
    "test:wikipedia": "node --test scripts/test-wikipedia.mjs",
    "test:tracker": "node --test scripts/test-object-tracker.mjs",
    "update-deps": "npx npm-check-updates -u --reject 'react-router-dom' && npm install",
    "deploy": "npm run build && wrangler deploy"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
